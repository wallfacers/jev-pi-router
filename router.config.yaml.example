# jev-pi-router 默认配置（contracts/config-schema.md）
# 复制为 router.config.yaml 后按需修改；增删厂商/调池只改本文件（FR-013）。
version: 1

# ── 模型池（有序；顺序 = 手动模式路由优先级；FR-001）────────────────
# family：同源组标识（002 FR-004）——同底层模型的条目声明相同 family，
# 跨厂商互审原则上不互为 reviewer；缺省/空 = 独立条目。
strong_pool:
  - vendor: mimo
    model: mimo-v2.6-pro
    api_ref: mimo/mimo-v2.6-pro
    cost_hint: 1.0
    cache_passthrough: unknown    # jev-pi-doctor probe --write-back 回填
    enabled: true
  - vendor: glm
    model: glm-5.3
    api_ref: glm/glm-5.3
    family: glm-5.3               # 与 qianwenai/glm-5.3 同底层模型
    cost_hint: 1.0
    cache_passthrough: unknown
    enabled: true
  - vendor: qianwenai
    model: qwen3.8-max
    api_ref: qianwenai/qwen3.8-max
    family: qwen3.8-max
    cost_hint: 1.0                # 平权：与全部强池条目同值（002 R4）
    cache_passthrough: full       # 千问 Token Plan 官方直连，pi 侧已声明 promptCache（002 R5）
    enabled: true
  - vendor: qianwenai
    model: glm-5.3
    api_ref: qianwenai/glm-5.3
    family: glm-5.3               # 与 glm/glm-5.3 同源，互审互斥（002 FR-004）
    cost_hint: 1.0
    cache_passthrough: full
    enabled: true

flash_pool:
  - vendor: deepseek
    model: deepseek-flash
    api_ref: deepseek/deepseek-flash
    cost_hint: 0.15
    cache_passthrough: full       # api.deepseek.com 官方直连，厂商侧缓存已知存在
    enabled: true
  - vendor: glm
    model: glm-5.3-flash
    api_ref: glm/glm-5.3-flash
    cost_hint: 0.15
    cache_passthrough: unknown
    enabled: true
  - vendor: relay
    model: cmd-deepseek-v4.1-flash
    api_ref: relay/cmd-deepseek-v4.1-flash
    family: deepseek-v4.1-flash   # 与 qianwenai/deepseek-v4.1-flash 同底层模型
    cost_hint: 0.1
    cache_passthrough: unknown    # 本地中转，doctor probe 实测项
    enabled: true
  - vendor: opencode-go
    model: deepseek-flash
    api_ref: opencode-go/deepseek-flash
    cost_hint: 0.1
    cache_passthrough: unknown    # 中转，doctor probe 实测项
    enabled: true
  - vendor: qianwenai
    model: qwen3.8-flash
    api_ref: qianwenai/qwen3.8-flash
    family: qwen3.8-flash
    cost_hint: 0.15               # 平权：与直连 flash 档同级（002 R4）
    cache_passthrough: full
    enabled: true
  - vendor: qianwenai
    model: deepseek-v4.1-flash
    api_ref: qianwenai/deepseek-v4.1-flash
    family: deepseek-v4.1-flash   # 与 relay/cmd-deepseek-v4.1-flash 同源
    cost_hint: 0.1                # 平权：与同源条目同值（002 R4）
    cache_passthrough: full
    enabled: true

# ── 角色 → 池绑定（FR-002；implement 必须 = flash，FR-003）─────────
roles:
  orchestrator: strong
  plan: strong
  decision: strong
  review: strong
  fallback_arbiter: strong
  implement: flash

# ── 跨厂商 review（FR-007/008）────────────────────────────────────
review:
  code: cross_vendor_strong
  plan_decision: mutual_strong
  max_rounds: 2
  degrade_to_single_vendor: true   # 强池仅单厂商时降级 + 显式标记（US2-3）

# ── 决策引擎（FR-005/006）────────────────────────────────────────
decision_engine:
  primary: jev
  fallback: rules
  timeout_ms: 2000
  fail_open: true                  # 投产必须 true（FR-006）

# ── 双轨兜底（FR-009/010）────────────────────────────────────────
fallback:
  fault_transfer:
    max_attempts: 2
  quality_upgrade:
    review_fails: 2
    escalate_to: strong
    switch_vendor: true
  breaker:
    consecutive_failures: 3
    cooldown_sec: 300
    window_sec: 3600              # api_ref 滑窗长度（秒，v1.4 条目级滑窗冷却）
    window_failures: 2            # 滑窗内 N 次熔断类失败 → 该 api_ref 冷却
    api_ref_cooldown_sec: 300     # api_ref 冷却时长（成功回报即时解除）

# ── 自动模式 / 自动探测（FR-012）──────────────────────────────────
auto_mode:
  enabled: false
  probe_interval_min: 30
  signals: [availability, cost, latency, cache]

# ── B 模式（FR-004）──────────────────────────────────────────────
b_mode:
  allow_per_turn_switch_on_fresh_session: true
