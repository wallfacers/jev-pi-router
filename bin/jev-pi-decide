#!/usr/bin/env python3
"""jev-pi-decide — 路由决策 CLI（contracts/decision-cli.md）。

stdin: request JSON → stdout: response JSON。
退出码：0 成功（含 fail-open）；2 配置错误；3 参数/输入 JSON 非法。
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))

from jev_pi_router.config import ConfigError                      # noqa: E402
from jev_pi_router.decide import UsageError, decide              # noqa: E402


class DecideArgumentParser(argparse.ArgumentParser):
    """用法错误统一退出码 3（契约 decision-cli.md §4：2=配置错误、3=参数/输入非法）。

    argparse 默认 sys.exit(2) 与配置错误同码，会误导调用方；此处覆写 error()：
    打印 usage + 结构化 error JSON 到 stderr 后按 3 退出（stdout 仍保持“永远是合法 JSON”）。
    """

    def error(self, message: str):                                  # noqa: A003
        self.print_usage(sys.stderr)
        print(json.dumps({"error": f"参数非法: {message}"}, ensure_ascii=False), file=sys.stderr)
        sys.exit(3)


def main() -> int:
    parser = DecideArgumentParser(prog="jev-pi-decide")
    parser.add_argument("--engine", choices=("auto", "rules", "jev"), default="auto")
    parser.add_argument("--timeout-ms", type=int, default=None)
    parser.add_argument("--config", default=None, help="router.config.yaml 路径")
    args = parser.parse_args()

    try:
        request = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(json.dumps({"error": f"输入 JSON 非法: {exc}"}, ensure_ascii=False), file=sys.stderr)
        return 3

    try:
        response = decide(request, engine=args.engine, config_path=args.config, timeout_ms=args.timeout_ms)
    except UsageError as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False), file=sys.stderr)
        return 3
    except ConfigError as exc:
        print(json.dumps({"error": f"配置错误: {exc}"}, ensure_ascii=False), file=sys.stderr)
        return 2

    print(json.dumps(response, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
